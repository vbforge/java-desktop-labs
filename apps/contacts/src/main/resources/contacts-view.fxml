<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vbforge.contacts.ContactsController"
            styleClass="root-pane">

    <padding>
        <Insets top="14" right="18" bottom="14" left="18"/>
    </padding>

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Storage" styleClass="dim-label"/>
            <ComboBox fx:id="backendCombo" prefWidth="120"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="importBtn" text="Import…"/>
            <Button fx:id="exportBtn" text="Export…"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding>
                <Insets top="14"/>
            </padding>

            <VBox spacing="12" prefWidth="300" minWidth="260">
                <Label text="Contact details" styleClass="section-title"/>

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="56"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Name"  GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField"  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Phone" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="phoneField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="8">
                    <Button fx:id="addBtn"    text="Add" defaultButton="true"/>
                    <Button fx:id="updateBtn" text="Update"/>
                    <Button fx:id="deleteBtn" text="Delete"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label styleClass="hint-label" wrapText="true"
                       text="Select a row to load it into the form. Edit and press Update — or just double-click the row."/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="10">
                <TextField fx:id="searchField" promptText="Search by name, phone or email…"/>
                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameCol"  text="Name"  prefWidth="220"/>
                        <TableColumn fx:id="phoneCol" text="Phone" prefWidth="160"/>
                        <TableColumn fx:id="emailCol" text="Email" prefWidth="240"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox>
            <padding>
                <Insets top="10"/>
            </padding>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>